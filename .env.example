# モック / 実API の差し替えスイッチ（既定はすべてモック）
# ここに無い変数は app/settings.py が読まない。足すときは両方に足す。
TRANSIT_PROVIDER=mock          # mock | ekispert
LLM_PROVIDER=stub              # stub | gemini
REPOSITORY=firestore           # firestore（既定）| memory（テスト用の揮発ストア）

# 実APIに差し替えるときだけ設定する
EKISPERT_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash   # 既定。gemini-3.5-flash 等に変更可
GOOGLE_CLOUD_PROJECT=mannaka-local
FIRESTORE_EMULATOR_HOST=firestore:8200   # ローカルはエミュレータ。Cloud Run では未設定

# 評価のパラメータ
CANDIDATE_LIMIT=8              # 出す候補地の数
BUFFER_MINUTES=10              # 到着バッファ

# ホスト側の公開ポート
HOST_PORT=8081
